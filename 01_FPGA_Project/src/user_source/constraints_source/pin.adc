# Test-copy-only addition: schematic KEY3 -> FPGA B1.
set_pin_assignment { key_pause } { LOCATION = B1; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }

# Local encoder menu, revised to GPIOs next to J1.29 (3V3).
# HX4S20 HDL manual p13: J1.25=H15, J1.26=H16, J1.27=K16.
# All three are unused BANK1 3.3V GPIOs. V -> J1.29, G -> J1.30.
set_pin_assignment { knob_a } { LOCATION = H15; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; } # J1.25 GPIOA_22
set_pin_assignment { knob_b } { LOCATION = H16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; } # J1.26 GPIOA_23
set_pin_assignment { knob_s_n } { LOCATION = K16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; } # J1.27 GPIOA_24
# First board switch SWKEY_1 -> C8 (schematic SW1, UI SW0).
set_pin_assignment { sw0 } { LOCATION = C8; IOSTANDARD = LVCMOS33; PULLTYPE = NONE; }
# key2 remains C1 / physical KEY4, now menu return only.
# Joystick: X -> J1.16/M10/ADC_CH1, Y -> J1.15/L10/ADC_CH2.
# Analog pads are reserved by EG_PHY_ADC CH1/CH2; never create digital ports
# or enable digital pull-ups on X/Y. V -> J1.29 (3V3), G -> J1.30.
set_pin_assignment { joy_button } { LOCATION = M16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; } # J1.28, same as tested board

# Alarm extension: manual p13 J1.24=J16, p18 BUZZER=H11. 3.3V signals only.
set_pin_assignment { reed_do } { LOCATION = J16; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment { buzzer_n } { LOCATION = H11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 4; PULLTYPE = PULLUP; }
